generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}


model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  refreshTokens RefreshToken[]
  balance       Decimal         @default("25000") // Default balance of 1 million
  lockedBalance Decimal         @default("0") // Locked balance for pending orders
  orders        Order[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Stock {
  id        String   @id @default(cuid())
  name      String
  symbol    String    @unique  // SOL BTC ETH
  price     Decimal
  createdAt DateTime @default(now())
  order     Order[]
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  market    MarketType   //limit market
  quantity  Int
  price     Decimal
  orderType OrderType   // buy sell
  status    Status
  createdAt DateTime @default(now())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fill      Fill[]
}

enum MarketType {
  LIMIT    
  MARKET
}

enum OrderType {
  BUY
  SELL
}

enum Status {
  PENDING
  FILLED
  CANCELLED
}


model Fill {
  id        String   @id @default(cuid())
  orderId   String
  price     Decimal
  quantity  Int
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

}
